-- Network contract (SCHEMAS §9, D-050). Blink compiles this into typed remotes.
-- check.sh regenerates src/client/Net.luau and src/server/Net.luau (committed, never hand-edited). The client is never trusted (server authority).

option ClientOutput = "../src/client/Net.luau"
option ServerOutput = "../src/server/Net.luau"
option ManualReplication = false

enum ActionKind = { Attack, Parry, Guard, Stance }

-- C→S: ask to cast a Move. The server validates moveId, cooldown, Qi and Strain.
event CastRequest {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		moveId: string(..64),
		generation: string(..64),
		aim: vector,
		point: vector?, -- ground point for `target = "Point"` moves (Rime Fall, T-027d1); validated server-side
		seq: u16,
	},
}

-- Listener-ready / replication-race sync: never rotates server generation.
event CastSync {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: u8,
}
event CastGeneration {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		generation: string(..64),
		epoch: u32,
		character: Instance(Model)?,
	},
}

-- Full authoritative acceptance. Fresh broadcast, duplicate response owner-only.
event CastAccepted {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		castId: string(..70), generation: string(..64), seq: u16, moveId: string(..64),
		casterUserId: f64, characterKey: string(..64), slotRevision: u32,
		acceptedAt: f64, releaseAt: f64, endsAt: f64,
		aim: vector, origin: vector, centre: vector?,
	},
}
-- Expired means response unavailable, NOT cancellation of a paid world hazard.
event CastDisposition {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		generation: string(..64), seq: u16, moveId: string(..64),
		status: string(..16), reason: string(..64),
	},
}

-- C→S: basic actions.
event Action {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		kind: ActionKind,
		dir: vector?,
		seq: u16,
	},
}

-- C→S: put Kith `uid` in core slot `slot` ("" unequips). The server checks rank, slot and ownership (T-016b).
event Equip {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		slot: u8,
		uid: string(..64),
	},
}

-- C→S: select core slot `slot` (keys 1–7 / touch tap); only that slot's Kith is live (T-036a, D-216).
event SelectSlot {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		slot: u8,
	},
}

-- C→S: aim direction for other players' FX only; never trusted for hits.
event Aim {
	From: Client,
	Type: Unreliable,
	Call: SingleSync,
	Data: vector,
}

-- S→C: cosmetic effects, keyed by Content fx ids.
event CastFx {
	From: Server,
	Type: Unreliable,
	Call: SingleSync,
	Data: struct {
		fxId: string(..64),
		caster: Instance(Player),
		pos: vector,
		dir: vector,
	},
}

event HitFx {
	From: Server,
	Type: Unreliable,
	Call: SingleSync,
	Data: struct {
		fxId: string(..64),
		caster: Instance(Player),
		pos: vector,
		dir: vector,
		target: Instance(Model)?,
		amount: f32,
	},
}

-- S→C: entity state (tags are the viewer layer only).
event EntityState {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		uid: string(..64),
		hp: f32,
		qi: f32,
		tags: string(..64)[..32],
		rank: u8,
	},
}

-- S→C: changed profile paths only.
event ProfileDelta {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		path: string(..128),
		value: unknown,
	}[..64],
}
-- C→S: start Binding the weakened wild Kith `target` (T-017b). The server checks Kith, health and range.
event BindStart {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		target: Instance(Model),
	},
}

-- C→S: Binding input: `channel` = channel held; `shard` = spend one Shard for Qi this press.
event BindInput {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		channel: boolean,
		shard: boolean,
	},
}

-- C→S: feed owned Kith `uid` one meal of its species food from the profile items; `rare` wakes a Dormant Kith (T-018b).
event Feed {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		uid: string(..64),
		rare: boolean,
	},
}

-- C→S: Refine held / released (T-018d). The server checks the rest spot and spends Shards into Stage progress.
event Refine {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		holding: boolean,
	},
}

-- C→S: start the Rank breakthrough trial (T-018f, D-080). The server checks a full Peak and the rest spot.
event Breakthrough {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		start: boolean,
	},
}

-- C→S: start a Crucible fusion of owned Kith `a` + `b` at a rest spot (T-019c, D-083). Server checks the recipe.
event CrucibleStart {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		a: string(..64),
		b: string(..64),
	},
}

-- C→S: focus mini-game press. The server scores it against its own clock and zones.
event CruciblePress {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		press: boolean,
	},
}

-- C→S: set the Weave on equipped core move `core` with support `support` ("" clears it) at a rest spot (T-020c, D-090).
event WeaveSet {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		core: string(..64),
		support: string(..64),
	},
}
